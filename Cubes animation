//sketch.js 
let size = 50;
let rows; let cols;

let boxes = [];

function setup() {
  createCanvas(400, 400, WEBGL);
  angleMode(DEGREES);
  cols = width/size;
  rows = height/size;

  for (let i=0; i<cols; i++) {
     boxes[i] = [];
    for (let j=0; j<rows; j++) {
      boxes[i][j] = new Box(size/2 + i*size - size*cols/2, size/2 + j*size - size*rows/2);
    }
  } 
}

function draw() {
  background(220);

  
  let x = map(mouseX, 0, width, 0, 360);
  //rotateX(x)
  //rotateY(x)
  //rotateZ(x)
 
 for(let i=0; i<cols; i++) {
   for(let j=0; j<rows; j++) {
     boxes[i][j].display();
   }
 }
}

//box.js
class Box {
  constructor (x, y) {
    this.x = x;
    this.y = y;
  }

  display () {
        let x = map(mouseX,0 , width, 0, 360);
        fill(255);
        push();
        translate(this.x, this.y);
        rotateX(x);
        rotateY(x);
        box(size - 1/3*size); 
        pop(); 
  }
  
}


